@top Program { Line* }

@skip { space | Comment }

Line {
  Statement? eol
}

Statement {
  Instruction |
  Directive |
  Label |
  Keyword
}

Label { Identifier ":" | Identifier }

Instruction {
  Opcode Operand?
}

Register {
  @specialize<Identifier, "X" | "Y" | "A" | "x" | "y" | "a">
}

Directive {
  (DirectiveName | PseudoOp) (Expression)*
}

PseudoOp {
  @specialize<Identifier, "ORG" | "EQU" | "END" | "org" | "equ" | "end">
}

Keyword {
  @specialize<Identifier,  "processor">
}

Opcode {
  @specialize<Identifier,
    "ADC" | "AND" | "ASL" | "BCC" | "BCS" | "BEQ" | "BIT" | "BMI" |
    "BNE" | "BPL" | "BRK" | "BVC" | "BVS" | "CLC" | "CLD" | "CLI" |
    "CLV" | "CMP" | "CPX" | "CPY" | "DEC" | "DEX" | "DEY" | "EOR" |
    "INC" | "INX" | "INY" | "JMP" | "JSR" | "LDA" | "LDX" | "LDY" |
    "LSR" | "NOP" | "ORA" | "PHA" | "PHP" | "PLA" | "PLP" | "ROL" |
    "ROR" | "RTI" | "RTS" | "SBC" | "SEC" | "SED" | "SEI" | "STA" |
    "STX" | "STY" | "TAX" | "TAY" | "TSX" | "TXA" | "TXS" | "TYA" |
    "adc" | "and" | "asl" | "bcc" | "bcs" | "beq" | "bit" | "bmi" |
    "bne" | "bpl" | "brk" | "bvc" | "bvs" | "clc" | "cld" | "cli" |
    "clv" | "cmp" | "cpx" | "cpy" | "dec" | "dex" | "dey" | "eor" |
    "inc" | "inx" | "iny" | "jmp" | "jsr" | "lda" | "ldx" | "ldy" |
    "lsr" | "nop" | "ora" | "pha" | "php" | "pla" | "plp" | "rol" |
    "ror" | "rti" | "rts" | "sbc" | "sec" | "sed" | "sei" | "sta" |
    "stx" | "sty" | "tax" | "tay" | "tsx" | "txa" | "txs" | "tya"
  >
}

Expression {
  (Value) (Operator Value)*
}

Value {
  Number |
  Identifier |
  String |
  Char
}

Operator {
  "+" | "-" | "*" | "/" | "^" | "&" | "|" | "<<" | ">>" | "==" | "<" | ">" | "<=" | ">=" | "!="
}

Operand {
  "#" (Number | Identifier | String) |
  "(" (Number | Identifier) "," Register ")" |
  "(" (Number | Identifier) ")" ("," Register)? |
  (Number | Identifier) ("," Register)? |
  Register |
  String |
  Char
}

@tokens {
  Identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }

  DirectiveName { "." $[a-zA-Z_]+ }

  Hex { "$" $[0-9a-fA-F]+ }
  Bin { "%" $[01]+ }
  Dec { $[0-9]+ }

  Number { Hex | Bin | Dec }

  String { '"' (!["\\\n] | "\\" _)* '"' }

  Char { "'" ![\n] "'"? }

  Comment { ";" ![\n]* }

  space { $[ \t]+ }
  eol { $[\n\r]+ }

  ","
  "#"
  "(" ")"
  @precedence { String, Char }
}

@precedence {
  PseudoOp,
  Opcode,
  Label
}

@detectDelim
